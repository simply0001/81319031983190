		X-Frame-Options "DENY"
		X-Robots-Tag "noindex, nofollow"
	}

	handle /config.js {
		header Content-Type "text/javascript; charset=utf-8"
		respond "window.POCKETPASS_ADMIN_API_URL='https://api.pocketpass.xyz';window.POCKETPASS_ADMIN_KEY='{$SUPABASE_PUBLISHABLE_KEY}';window.POCKETPASS_ADMIN_STUDIO_URL='https://studio.pocketpass.xyz';" 200
	}

	handle {
		root * /srv/admin
		file_server
	}
}

