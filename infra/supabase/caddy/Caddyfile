studio.pocketpass.xyz {
	import security_headers
	encode zstd gzip

	log {
		output stdout
		format json
	}

	header {
		X-Frame-Options "DENY"
		X-Robots-Tag "noindex, nofollow"
	}

	@mcp path /api/mcp /api/mcp/*
	handle @mcp {
		respond "Forbidden" 403
	}

	handle /_pocketpass/login {
		root * /srv/studio
		rewrite * /login.html
		header Cache-Control "no-store"
		file_server
	}

	@assets path /_next/static/*
	handle @assets {
		reverse_proxy studio:3000
	}

	handle {
		forward_auth rest:3000 {
			uri /rpc/studio_gate?
			header_up Accept "application/json"
			header_up -Authorization
			@denied status 401
			handle_response @denied {
				redir * /_pocketpass/login 302
			}
		}
		reverse_proxy studio:3000 {
			header_up X-Real-IP {remote_host}
		}
	}
}
