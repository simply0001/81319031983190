[Unit]
Description=PocketPass stack health check
Wants=docker.service
After=docker.service
OnFailure=pocketpass-onfailure@%n.service

[Service]
Type=oneshot
Environment=ENV_FILE=/opt/pocketpass/app/infra/supabase/.env.production
ExecStart=/opt/pocketpass/app/infra/supabase/scripts/health.sh
Nice=10
