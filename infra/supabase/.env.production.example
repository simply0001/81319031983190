# Copy to a root-owned .env.production outside version control. Every
# REPLACE_ME value is required unless its comment says otherwise.

# Deployment layout and pinned upstream release.
COMPOSE_PROJECT_NAME=pocketpass
POCKETPASS_INFRA_DIR=/opt/pocketpass/app/infra/supabase
SUPABASE_UPSTREAM_DIR=/opt/pocketpass/supabase-upstream/docker
SUPABASE_UPSTREAM_REF=241bb11c0627f2981746d37033f57dbfa81d29b0
CADDY_IMAGE=caddy:2.11.4-alpine@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648

# Public endpoints.
SUPABASE_PUBLIC_URL=https://api.pocketpass.xyz
API_EXTERNAL_URL=https://api.pocketpass.xyz/auth/v1
SITE_URL=https://links.pocketpass.xyz
ADDITIONAL_REDIRECT_URLS=https://links.pocketpass.xyz/auth/callback,pocketpass://auth/callback,https://developer.pocketpass.xyz/
PROXY_DOMAIN=api.pocketpass.xyz
ACME_EMAIL=REPLACE_ME_TLS_CONTACT_EMAIL

# Database and generated Supabase keys. Generate a new coherent set with the
# official Supabase self-hosting key generator; never reuse upstream examples.
POSTGRES_PASSWORD=REPLACE_ME_RANDOM_POSTGRES_PASSWORD
JWT_SECRET=REPLACE_ME_RANDOM_LEGACY_JWT_SECRET_AT_LEAST_32_CHARACTERS
ANON_KEY=REPLACE_ME_GENERATED_LEGACY_ANON_JWT
SERVICE_ROLE_KEY=REPLACE_ME_GENERATED_LEGACY_SERVICE_ROLE_JWT
SUPABASE_PUBLISHABLE_KEY=REPLACE_ME_GENERATED_SB_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=REPLACE_ME_GENERATED_SB_SECRET_KEY
ANON_KEY_ASYMMETRIC=REPLACE_ME_GENERATED_ASYMMETRIC_ANON_JWT
SERVICE_ROLE_KEY_ASYMMETRIC=REPLACE_ME_GENERATED_ASYMMETRIC_SERVICE_ROLE_JWT
JWT_KEYS=REPLACE_ME_SINGLE_LINE_PRIVATE_JWK_JSON
JWT_JWKS=REPLACE_ME_SINGLE_LINE_PUBLIC_JWKS_JSON
SECRET_KEY_BASE=REPLACE_ME_RANDOM_64_PLUS_CHARACTER_SECRET
REALTIME_DB_ENC_KEY=REPLACE_ME_RANDOM_REALTIME_ENCRYPTION_KEY
VAULT_ENC_KEY=REPLACE_ME_EXACTLY_32_CHARACTER_VAULT_KEY
PG_META_CRYPTO_KEY=REPLACE_ME_RANDOM_32_PLUS_CHARACTER_META_KEY

# Internal database routing. No database or pooler ports are published by the
# production override.
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=REPLACE_ME_RANDOM_TENANT_ID
POOLER_DB_POOL_SIZE=5

# Studio at studio.pocketpass.xyz is opened from the admin console with a
# short-lived owner session; no dashboard password is used. The upstream
# compose file still requires these two values, so keep them random. See
# "Studio access" in the README.
DASHBOARD_USERNAME=REPLACE_ME_STUDIO_USERNAME
DASHBOARD_PASSWORD=REPLACE_ME_RANDOM_STUDIO_PASSWORD
STUDIO_DEFAULT_ORGANIZATION=PocketPass
STUDIO_DEFAULT_PROJECT=PocketPass
OPENAI_API_KEY=

# Auth policy.
JWT_EXPIRY=3600
PUBLIC_API_ENABLED=true
# Discord webhook that receives developer limit requests and their decisions.
# Stored in Vault by scripts/sync-vault-secrets.sh; leave empty to disable.
DISCORD_LIMIT_REQUESTS_WEBHOOK_URL=
# Discord webhook that receives every Ko-fi payment with its match result.
# Stored in Vault by scripts/sync-vault-secrets.sh; leave empty to disable.
DISCORD_SUPPORTERS_WEBHOOK_URL=
# Ko-fi webhook verification token (Ko-fi > Webhooks > Advanced). Stored in
# Vault by scripts/sync-vault-secrets.sh; empty leaves the endpoint refusing
# every delivery.
KOFI_VERIFICATION_TOKEN=
# Public signup is intentionally open: email-OTP accounts and username+password
# accounts (whose GoTrue address is <username>@users.pocketpass.xyz). Abuse is
# limited by the Kong per-IP limits on POST /auth/v1/otp (10/minute, 60/hour),
# POST /auth/v1/signup (5/minute, 20/hour) and password sign-in (10/minute,
# 60/hour), GoTrue SMTP_MAX_FREQUENCY=60s, and AUTH_EMAILS_PER_HOUR=1000.
# ENABLE_EMAIL_AUTOCONFIRM is true so username accounts, which can never
# receive mail, are usable at once; the guard_password_signups trigger refuses
# password sign-ups on any other domain. Keep these flags in sync with
# scripts/configure-production-env.sh.
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
PASSWORD_MIN_LENGTH=8
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify
EMAIL_OTP_EXPIRY_SECONDS=600
EMAIL_OTP_TEMPLATE_URL=https://links.pocketpass.xyz/auth-email/otp.html
EMAIL_OTP_SUBJECT=Your PocketPass verification code
SMTP_MAX_FREQUENCY=60s
AUTH_EMAILS_PER_HOUR=1000

# Discord OAuth. The secret is server-only. The callback registered in Discord
# is https://api.pocketpass.xyz/auth/v1/callback.
DISCORD_ENABLED=true
DISCORD_CLIENT_ID=REPLACE_ME_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=REPLACE_ME_DISCORD_CLIENT_SECRET
DISCORD_REDIRECT_URI=https://api.pocketpass.xyz/auth/v1/callback

# Resend SMTP placeholders. Port 465 uses implicit TLS; SMTP_PASS is the Resend API key.
SMTP_ADMIN_EMAIL=REPLACE_ME_VERIFIED_RESEND_SENDER
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=REPLACE_ME_RESEND_API_KEY
SMTP_SENDER_NAME=PocketPass

# Storage.
GLOBAL_S3_BUCKET=pocketpass
REGION=local
STORAGE_TENANT_ID=pocketpass
S3_PROTOCOL_ACCESS_KEY_ID=REPLACE_ME_RANDOM_S3_PROTOCOL_ACCESS_KEY
S3_PROTOCOL_ACCESS_KEY_SECRET=REPLACE_ME_RANDOM_S3_PROTOCOL_SECRET
MINIO_ROOT_USER=REPLACE_ME_RANDOM_MINIO_USER
MINIO_ROOT_PASSWORD=REPLACE_ME_RANDOM_MINIO_PASSWORD
IMGPROXY_AUTO_WEBP=true

# PostgREST and Edge Functions.
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public
FUNCTIONS_VERIFY_JWT=true

# Upstream logging variables. Keep values private even when the optional
# analytics override is not enabled.
LOGFLARE_PUBLIC_ACCESS_TOKEN=REPLACE_ME_RANDOM_LOGFLARE_PUBLIC_TOKEN
LOGFLARE_PRIVATE_ACCESS_TOKEN=REPLACE_ME_RANDOM_LOGFLARE_PRIVATE_TOKEN
DOCKER_SOCKET_LOCATION=/var/run/docker.sock

# These inherited ports are removed by compose.production.yml. Values are still
# required while Docker Compose renders the upstream file.
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# Encrypted off-host backups. The age recipient is public; the matching private
# identity must not be stored in this file or on the VM. The VM keeps only a
# short rolling window; a local server pulls each archive off-site (see the
# "Backups" section of README.md).
BACKUP_DIRECTORY=/var/backups/pocketpass
BACKUP_AGE_RECIPIENT=REPLACE_ME_AGE_PUBLIC_RECIPIENT
BACKUP_RETENTION_DAYS=7

FIREBASE_SERVICE_ACCOUNT_FILE=/opt/pocketpass/secrets/firebase-service-account.json
